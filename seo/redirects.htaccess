# 301 redirects: old Wix URLs -> new site.
# Generated from seo/03-url-migration-map.csv - do not hand-edit.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^home-cc/?$ / [R=301,L]
  RewriteRule ^gallery-custom-cabinetry/?$ /custom-cabinetry [R=301,L]
  RewriteRule ^bedroom-and-bathroom-cabinetry/?$ /bedroom-cupboards [R=301,L]
  RewriteRule ^contact-us/?$ /contact [R=301,L]
  RewriteRule ^about-us/?$ /about [R=301,L]
  RewriteRule ^gallery-bedroom-cupboards/?$ /bedroom-cupboards [R=301,L]
  RewriteRule ^gallery-bathroom-cabinetry/?$ /bathroom-cabinets [R=301,L]
  RewriteRule ^gallery-diy-units/?$ /diy-units [R=301,L]
  RewriteRule ^checkout/?$ /get-a-quote [R=301,L]
  RewriteRule ^post/the-ultimate-guide-to-durable-quartz-countertops/?$ /blog/durable-quartz-countertops [R=301,L]
  RewriteRule ^post/transform-your-space-a-complete-guide-to-choosing-the-perfect-kitchen-units/?$ /blog/choosing-the-perfect-kitchen-units [R=301,L]
  RewriteRule ^post/cupboard-warehouse/?$ /blog [R=301,L]
  RewriteRule ^post/shop-fitting/?$ /blog/expert-solutions-for-shop-fitting [R=301,L]
  RewriteRule ^post/timeless-elegance-granite-countertops-for-your-home/?$ /blog/granite-countertops-for-your-home [R=301,L]
  RewriteRule ^post/top-tips-for-selecting-ideal-kitchen-countertops--ultimate-guide-to-choosing-the-perfect-kitchen-countertops---expert-tips-and-advice-to-help-you-select-the-ideal-countertops-for-your-space/?$ /blog/durable-quartz-countertops [R=301,L]
  RewriteRule ^bedroom-cabinetry/?$ /bedroom-cupboards [R=301,L]
  RewriteRule ^product-details/product/cc1/?$ /product-flat-pack-wardrobe [R=301,L]
</IfModule>
