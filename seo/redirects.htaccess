# 301 redirects: old Wix URLs -> new site.
# Generated from seo/03-url-migration-map.csv - do not hand-edit.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^home-cc/?$ / [R=301,L]
  RewriteRule ^gallery-designs-of-kitchen-cupboard/?$ /gallery-designs-of-kitchen-cupboard.html [R=301,L]
  RewriteRule ^shop/?$ /shop.html [R=301,L]
  RewriteRule ^gallery-custom-cabinetry/?$ /custom-cabinetry.html [R=301,L]
  RewriteRule ^bedroom-and-bathroom-cabinetry/?$ /bedroom-cupboards.html [R=301,L]
  RewriteRule ^contact-us/?$ /contact.html [R=301,L]
  RewriteRule ^about-us/?$ /about.html [R=301,L]
  RewriteRule ^kitchen-units/?$ /kitchen-units.html [R=301,L]
  RewriteRule ^blog/?$ /blog.html [R=301,L]
  RewriteRule ^get-a-quote/?$ /get-a-quote.html [R=301,L]
  RewriteRule ^melamine-doors-quartz-countertops/?$ /melamine-doors-quartz-countertops.html [R=301,L]
  RewriteRule ^gallery-bedroom-cupboards/?$ /bedroom-cupboards.html [R=301,L]
  RewriteRule ^gallery-bathroom-cabinetry/?$ /bathroom-cabinets.html [R=301,L]
  RewriteRule ^gallery-diy-units/?$ /diy-units.html [R=301,L]
  RewriteRule ^faq/?$ /faq.html [R=301,L]
  RewriteRule ^cupboard-installation/?$ /cupboard-installation.html [R=301,L]
  RewriteRule ^cart/?$ /cart.html [R=301,L]
  RewriteRule ^checkout/?$ /get-a-quote.html [R=301,L]
  RewriteRule ^post/the-ultimate-guide-to-durable-quartz-countertops/?$ /blog/durable-quartz-countertops.html [R=301,L]
  RewriteRule ^post/transform-your-space-a-complete-guide-to-choosing-the-perfect-kitchen-units/?$ /blog/choosing-the-perfect-kitchen-units.html [R=301,L]
  RewriteRule ^post/cupboard-warehouse/?$ /blog.html [R=301,L]
  RewriteRule ^post/shop-fitting/?$ /blog/expert-solutions-for-shop-fitting.html [R=301,L]
  RewriteRule ^post/timeless-elegance-granite-countertops-for-your-home/?$ /blog/granite-countertops-for-your-home.html [R=301,L]
  RewriteRule ^post/top-tips-for-selecting-ideal-kitchen-countertops--ultimate-guide-to-choosing-the-perfect-kitchen-countertops---expert-tips-and-advice-to-help-you-select-the-ideal-countertops-for-your-space/?$ /blog/durable-quartz-countertops.html [R=301,L]
  RewriteRule ^bedroom-cabinetry/?$ /bedroom-cupboards.html [R=301,L]
  RewriteRule ^product-details/product/cc1/?$ /product-flat-pack-wardrobe.html [R=301,L]
</IfModule>
